# Copy this file to `.env` and fill in real values. NEVER commit .env.
# All settings are optional — the system runs without any keys:
#   - Without ANTHROPIC_API_KEY the agents use a deterministic offline
#     heuristic mode (clearly labeled in memos) so the pipeline is testable.
#   - Without NEWS_API_KEY the news server falls back to GDELT + Google News
#     RSS, both keyless.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4000

# --- News (optional) ---
NEWS_API_KEY=your-newsapi-key-here

# --- Caching / rate limiting ---
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=30

# --- Orchestrator ---
MAX_VERIFICATION_RETRIES=1
DEFAULT_LOOKBACK_DAYS=90
